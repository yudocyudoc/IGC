# Makefile generated by OpenModelica
# Platform: linux64

# Simulations use -O3 by default
CC=clang
CXX=clang++ -std=c++17
LINK=clang -shared
EXEEXT=
DLLEXT=.so
CFLAGS_BASED_ON_INIT_FILE=
# define OMC_CFLAGS_OPTIMIZATION env variable to your desired optimization level to override this
OMC_CFLAGS_OPTIMIZATION=-Os
DEBUG_FLAGS=$(OMC_CFLAGS_OPTIMIZATION)
CFLAGS= $(CFLAGS_BASED_ON_INIT_FILE) $(DEBUG_FLAGS) -DOM_HAVE_PTHREADS -fPIC -falign-functions -mfpmath=sse -fno-dollars-in-identifiers -Wno-parentheses-equality ${MODELICAUSERCFLAGS}   
CPPFLAGS= -I"/usr/bin/../include/omc/c" -I"/usr/bin/../include/omc" -I. -DOPENMODELICA_XML_FROM_FILE_AT_RUNTIME -DOMC_MODEL_PREFIX=artifacts_ct02_exact_two_m00 -DOMC_NUM_MIXED_SYSTEMS=0 -DOMC_NUM_LINEAR_SYSTEMS=0 -DOMC_NUM_NONLINEAR_SYSTEMS=0 -DOMC_NDELAY_EXPRESSIONS=0 -DOMC_NVAR_STRING=0
# define OMC_LDFLAGS_LINK_TYPE env variable to "static" to override this
OMC_LDFLAGS_LINK_TYPE=dynamic
RUNTIME_LIBS= -Wl,--no-as-needed -Wl,--disable-new-dtags -lSimulationRuntimeC -llapack -lblas  -lm -lomcgc -lryu -lpthread -rdynamic -Wl,--no-undefined
LDFLAGS=-L"/usr/bin/../lib/x86_64-linux-gnu/omc" -L"/usr/bin/../lib" -Wl,-rpath,"/usr/bin/../lib/x86_64-linux-gnu/omc"  -Wl,-rpath,"/usr/bin/../lib"   $(RUNTIME_LIBS) 
DIREXTRA=-L"/repo/artifacts/ct02-exact-two/M"
MAINFILE=artifacts/ct02-exact-two/m00.c
MAINOBJ=artifacts/ct02-exact-two/m00.o
CFILES=artifacts/ct02-exact-two/m00_functions.c artifacts/ct02-exact-two/m00_records.c \
artifacts/ct02-exact-two/m00_01exo.c artifacts/ct02-exact-two/m00_02nls.c artifacts/ct02-exact-two/m00_03lsy.c artifacts/ct02-exact-two/m00_04set.c artifacts/ct02-exact-two/m00_05evt.c artifacts/ct02-exact-two/m00_06inz.c artifacts/ct02-exact-two/m00_07dly.c \
artifacts/ct02-exact-two/m00_08bnd.c artifacts/ct02-exact-two/m00_09alg.c artifacts/ct02-exact-two/m00_10asr.c artifacts/ct02-exact-two/m00_11mix.c artifacts/ct02-exact-two/m00_12jac.c artifacts/ct02-exact-two/m00_13opt.c artifacts/ct02-exact-two/m00_14lnz.c \
artifacts/ct02-exact-two/m00_15syn.c artifacts/ct02-exact-two/m00_16dae.c artifacts/ct02-exact-two/m00_17inl.c artifacts/ct02-exact-two/m00_18spd.c 

OFILES=$(CFILES:.c=.o)
GENERATEDFILES=$(MAINFILE) artifacts/ct02-exact-two/m00.makefile artifacts/ct02-exact-two/m00_literals.h artifacts/ct02-exact-two/m00_functions.h $(CFILES)

.PHONY: omc_main_target clean bundle

# This is to make sure that artifacts/ct02-exact-two/m00_*.c are always compiled.
.PHONY: $(CFILES)

omc_main_target: $(MAINOBJ) artifacts/ct02-exact-two/m00_functions.h artifacts/ct02-exact-two/m00_literals.h $(OFILES)
	$(CC) -I. -o artifacts/ct02-exact-two/m00$(EXEEXT) $(MAINOBJ) $(OFILES) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)

omc_dll_target: $(MAINOBJ) artifacts/ct02-exact-two/m00_functions.h artifacts/ct02-exact-two/m00_literals.h $(OFILES)
	$(CC) -DOMC_DLL_MAIN_DEFINE -o $(MAINOBJ) -c $(MAINFILE) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)
	$(CC) -shared -I. -o artifacts/ct02-exact-two/m00$(DLLEXT) $(MAINOBJ) $(OFILES) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)

clean:
	@rm -f artifacts/ct02-exact-two/m00_records.o $(MAINOBJ)

bundle:
	@tar -cvf artifacts/ct02-exact-two/m00_Files.tar $(GENERATEDFILES)